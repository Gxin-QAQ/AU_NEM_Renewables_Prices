# Data and generated research artefacts
data/raw/
data/interim/
data/processed/
data/external/
outputs/figures/
outputs/tables/
*.parquet
*.zip
*.csv
__pycache__/
.ipynb_checkpoints/
.DS_Store
.venv/
.pytest_cache/
.local/

# Private research handoff and immutable local run records
/PROJECT_CONTEXT.md
/docs/decision_log.md
/docs/phase2_final_review.md
/docs/phase2_information_set_audit.md
/docs/work_plan.md
/report/phase2_application_summary.md
/outputs/phase2/*_manifest.json
/outputs/phase2/*_gate.json

# Keep the folder structure in version control
!data/**/.gitkeep
!outputs/**/.gitkeep

# Keep compact final result tables so the executed results notebook remains
# inspectable after a fresh clone. Large data and intermediate CSVs stay local.
!outputs/tables/
!outputs/tables/*.csv

# Keep immutable-source provenance copies outside the ignored data tree.
!provenance/
!provenance/*.csv
!provenance/*.md

# Compact Phase 2 summaries; row-level predictions and raw data stay local.
!outputs/phase2/*_metrics.csv
!outputs/phase2/*_calibration.csv
